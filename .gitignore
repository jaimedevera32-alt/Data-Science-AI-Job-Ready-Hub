*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Jupyter & IDEs
.ipynb_checkpoints
*/.ipynb_checkpoints/*
.vscode/
.idea/
*.swp
*.swo

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
